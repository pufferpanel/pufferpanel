{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go: Run Panel",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd",
            "cwd": "${workspaceFolder}/out",
            "args": ["runService"],
            "preLaunchTask": "go-requirements",
            "env": {
                "PUFFER_PANEL_WEB_FILES": "${workspaceFolder}/client/frontend/dist"
            }
        },
        {
            "name": "Go: Add user",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd",
            "cwd": "${workspaceFolder}/out",
            "args": ["user", "add"],
            "console": "integratedTerminal",
            "preLaunchTask": "out-configure"
        },
        {
            "name": "Yarn: Build",
            "request": "launch",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "yarn",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "cwd": "${workspaceFolder}/client",
            "preLaunchTask": "yarn-install-client"
        }
    ]
}